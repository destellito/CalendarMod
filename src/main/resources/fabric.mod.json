{
	"schemaVersion": 1,
	"id": "destellitocalendarmod",
	"version": "${version}",
	"name": "Destellito's Calendar Mod",
	"description": "Simple mod to answer the question 'What's the date today?' in our minecraft worlds, use /getdate to know! ",
	"authors": [
		"Destellito"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/destellito/CalendarMod"
	},
	"license": "MIT",
	"icon": "assets/destellitocalendarmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.destellito.calendar.DestellitosCalendarMod"
		],
		"fabric-datagen": [
			"net.destellito.calendar.DestellitosCalendarModDataGenerator"
		],
		"client": [
			"net.destellito.calendar.DestellitosCalendarModClient"
		]
	},
	"mixins": [
		"destellitocalendarmod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.21.5",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}